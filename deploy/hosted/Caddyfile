# Caddy for the hosted box. Install at /etc/caddy/Caddyfile and reload with
#   systemctl reload caddy
#
# Two kinds of site live here:
#
#   <label>.passband.email  one per tenant, GENERATED by squelch-warden into
#                           /etc/caddy/tenants/<label>.caddy and imported below.
#                           Never edit those by hand; a re-provision overwrites
#                           them.
#   warden.passband.email   this file, below. The control plane's only way in.
#
# Replace passband.email throughout with your own base domain, and the email
# address in the global block with yours.

{
	# ACME registration contact. Certificates are per hostname over HTTP-01,
	# which is why there is no wildcard site block anywhere in this file: a
	# `*.passband.email` block would need the DNS challenge, which needs a
	# Caddy built with a DNS provider plugin. At tens of tenants, per-host
	# certificates are simpler and cost nothing.
	email ops@example.com
}

# The agent door is not part of hosted. squelchd serves /mcp on the same
# listener as the human door, so every site that proxies a tenant must refuse
# it, and this snippet is the copy that a hand-written site block can import.
# The GENERATED tenant files carry the same refusal inline rather than importing
# this, so that a tenant file is correct on its own even if this file is
# replaced.
(no_agent_door) {
	handle /mcp* {
		respond 404
	}
}

# Every tenant squelch-warden has provisioned. The directory may be empty on a
# fresh box; Caddy tolerates a glob that matches nothing.
import /etc/caddy/tenants/*.caddy

# The provisioning API. Reachable from the internet because the control plane
# runs on Railway, and gated by SQUELCH_WARDEN_TOKEN: TLS here is what keeps
# that bearer off the wire in the clear.
warden.passband.email {
	import no_agent_door

	handle {
		reverse_proxy 127.0.0.1:8852
	}
}

# signup.passband.email is NOT served from this box. It is the control plane on
# Railway, and its DNS record is a CNAME straight to the Railway app: one less
# hop, and the box never sees a signup or an OAuth callback. If you ever decide
# to front it from here instead, this is the shape:
#
# signup.passband.email {
# 	import no_agent_door
# 	reverse_proxy https://<your-app>.up.railway.app {
# 		header_up Host {upstream_hostport}
# 	}
# }
